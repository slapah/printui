#include <windows.h>
#include <commctrl.h>
#include "printui.h"

1 24 "printui.manifest"

IDD_MAIN DIALOGEX 0, 0, 506, 354
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT | WS_EX_APPWINDOW
CAPTION "PrintUI"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Print server",-1,7,4,330,214
    LTEXT           "Server",-1,16,20,32,10
    EDITTEXT        IDC_SERVER,50,18,226,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Refresh",IDC_REFRESH,280,17,48,14,WS_TABSTOP
    CONTROL         "",IDC_PRINTER_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP | WS_CHILD | WS_VISIBLE,16,36,312,174

    GROUPBOX        "Queue",-1,344,4,155,128
    PUSHBUTTON      "Add network printer",IDC_ADD_NET,352,18,139,14,WS_TABSTOP
    PUSHBUTTON      "Delete network connection",IDC_DEL_NET,352,34,139,14,WS_TABSTOP
    PUSHBUTTON      "Set as default",IDC_Y,352,50,139,14,WS_TABSTOP
    PUSHBUTTON      "Print test page",IDC_K,352,66,139,14,WS_TABSTOP
    PUSHBUTTON      "Printer properties",IDC_P,352,82,139,14,WS_TABSTOP
    PUSHBUTTON      "Print queue view",IDC_O,352,98,139,14,WS_TABSTOP
    PUSHBUTTON      "Delete local printer",IDC_DEL_LOCAL,352,114,139,14,WS_TABSTOP

    GROUPBOX        "Driver",-1,344,134,155,84
    PUSHBUTTON      "Install printer from INF",IDC_IF,352,150,139,14,WS_TABSTOP
    PUSHBUTTON      "Install driver from INF",IDC_IA,352,166,139,14,WS_TABSTOP
    PUSHBUTTON      "Delete driver",IDC_DD,352,182,139,14,WS_TABSTOP

    GROUPBOX        "Selected printer",-1,7,220,330,76
    LTEXT           "Name",-1,16,236,32,10
    EDITTEXT        IDC_PRINTER,50,234,278,12,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Model",-1,16,252,32,10
    EDITTEXT        IDC_MODEL,50,250,150,12,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Port",-1,208,252,22,10
    EDITTEXT        IDC_PORT,232,250,96,12,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "INF",-1,16,268,32,10
    EDITTEXT        IDC_INF,50,266,218,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_INF_BROWSE,272,265,26,14,WS_TABSTOP
    LTEXT           "Settings",-1,16,284,32,10
    EDITTEXT        IDC_SETTINGS,50,282,218,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_SETTINGS_BROWSE,272,281,26,14,WS_TABSTOP

    GROUPBOX        "Files / extra",-1,344,220,155,76
    PUSHBUTTON      "Save settings",IDC_SS,352,236,139,14,WS_TABSTOP
    PUSHBUTTON      "Restore settings",IDC_SR,352,252,139,14,WS_TABSTOP
    AUTOCHECKBOX    "Quiet (/q)",IDC_QUIET,352,272,139,12,WS_TABSTOP

    LTEXT           "Raw",-1,7,304,28,10
    EDITTEXT        IDC_RAW,36,302,404,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Run",IDC_RAW_RUN,444,301,55,14,WS_TABSTOP

    LTEXT           "Cmd",-1,7,320,28,10
    EDITTEXT        IDC_PREVIEW,36,318,463,12,ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP

    LTEXT           "Status",-1,7,336,28,10
    EDITTEXT        IDC_STATUS,36,334,463,12,ES_AUTOHSCROLL | ES_READONLY
END
