#include <windows.h>
#include "printui.h"

1 24 "printui.manifest"

IDD_MAIN DIALOGEX 0, 0, 320, 258
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT | WS_EX_APPWINDOW
CAPTION "PrintUI"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Printer name",-1,7,8,68,10
    EDITTEXT        IDC_PRINTER,76,6,237,12,ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Server / UNC",-1,7,22,68,10
    EDITTEXT        IDC_SERVER,76,20,237,12,ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Driver model",-1,7,36,68,10
    EDITTEXT        IDC_MODEL,76,34,237,12,ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Port",-1,7,50,68,10
    EDITTEXT        IDC_PORT,76,48,237,12,ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "INF file",-1,7,64,68,10
    EDITTEXT        IDC_INF,76,62,178,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...",IDC_INF_BROWSE,258,61,55,14,WS_TABSTOP

    LTEXT           "Settings file",-1,7,78,68,10
    EDITTEXT        IDC_SETTINGS,76,76,178,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...",IDC_SETTINGS_BROWSE,258,75,55,14,WS_TABSTOP

    AUTOCHECKBOX    "Quiet (/q)",IDC_QUIET,76,92,90,12,WS_TABSTOP

    LTEXT           "Raw args",-1,7,108,68,10
    EDITTEXT        IDC_RAW,76,106,178,12,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Run raw args",IDC_RAW_RUN,258,105,55,14,WS_TABSTOP

    LTEXT           "Command",-1,7,122,68,10
    EDITTEXT        IDC_PREVIEW,76,120,237,12,ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP

    PUSHBUTTON      "Add network printer",IDC_ADD_NET,7,140,150,14,WS_TABSTOP
    PUSHBUTTON      "Delete network connection",IDC_DEL_NET,163,140,150,14,WS_TABSTOP
    PUSHBUTTON      "Delete local printer",IDC_DEL_LOCAL,7,156,150,14,WS_TABSTOP
    PUSHBUTTON      "Install printer from INF",IDC_IF,163,156,150,14,WS_TABSTOP
    PUSHBUTTON      "Install driver from INF",IDC_IA,7,172,150,14,WS_TABSTOP
    PUSHBUTTON      "Delete driver",IDC_DD,163,172,150,14,WS_TABSTOP
    PUSHBUTTON      "Set as default",IDC_Y,7,188,150,14,WS_TABSTOP
    PUSHBUTTON      "Print test page",IDC_K,163,188,150,14,WS_TABSTOP
    PUSHBUTTON      "Printer properties",IDC_P,7,204,150,14,WS_TABSTOP
    PUSHBUTTON      "Print queue view",IDC_O,163,204,150,14,WS_TABSTOP
    PUSHBUTTON      "Save settings to file",IDC_SS,7,220,150,14,WS_TABSTOP
    PUSHBUTTON      "Restore settings from file",IDC_SR,163,220,150,14,WS_TABSTOP

    LTEXT           "Status",-1,7,240,68,10
    EDITTEXT        IDC_STATUS,76,238,237,12,ES_AUTOHSCROLL | ES_READONLY
END
